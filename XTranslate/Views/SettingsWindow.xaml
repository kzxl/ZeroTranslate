<Window x:Class="XTranslate.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate — Cài đặt"
        Width="460" Height="490"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        ResizeMode="NoResize">

    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙ Cài đặt" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Tùy chỉnh hành vi và giao diện" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>

                <!-- SECTION: PHÍM TẮT -->
                <TextBlock Text="PHÍM TẮT DỊCH NHANH" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,6" />

                <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,4"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtHotkey" Grid.Column="0"
                                 IsReadOnly="True" FontSize="12.5" FontWeight="SemiBold"
                                 Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Cursor="Hand"
                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                 GotFocus="HotkeyBox_GotFocus"
                                 LostFocus="HotkeyBox_LostFocus"
                                 ToolTip="Click vào đây rồi nhấn tổ hợp phím mới" />
                        <TextBlock Grid.Column="1" x:Name="txtHotkeyHint"
                                   Text="Click để đổi" FontSize="10.5"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock Text="Bấm tổ hợp phím muốn dùng (ví dụ: Ctrl+D)" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,0,0,10" />

                <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,2,0,10" />

                <!-- SECTION: NGÔN NGỮ & ENGINE -->
                <TextBlock Text="NGÔN NGỮ &amp; ENGINE DỊCH" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,6" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ngôn ngữ đích mặc định" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="cboTargetLang" Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                  DisplayMemberPath="Name" Height="28" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Engine dịch" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="cboEngine" Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}" Height="28" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="chkEngineFallback"
                          Content="Tự động thử engine khác khi dịch lỗi"
                          Margin="0,0,0,10"
                          ToolTip="Khi engine đang chọn gặp lỗi, tự động dùng engine còn lại" />

                <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,2,0,10" />

                <!-- SECTION: HÀNH VI -->
                <TextBlock Text="HÀNH VI HỆ THỐNG" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,6" />

                <CheckBox x:Name="chkMinimizeToTray" Content="Thu nhỏ xuống khay hệ thống khi đóng"
                          Margin="0,0,0,6" />
                <CheckBox x:Name="chkStartMinimized" Content="Khởi động ở chế độ thu nhỏ"
                          Margin="0,0,0,6" />
                <CheckBox x:Name="chkShowFloatingIcon" Content="Hiện icon 🌐 khi chọn text (floating icon)"
                          Margin="0,0,0,6" />
                <CheckBox x:Name="chkInstantTranslate" Content="Dịch tức thì khi gõ (tự dịch sau 0.6s ngừng gõ)"
                          Margin="0,0,0,6" />
                <CheckBox x:Name="chkStartWithWindows" Content="Tự động chạy cùng Windows"
                          Margin="0,0,0,10" />

                <Rectangle Height="1" Fill="{StaticResource BorderSubtleBrush}" Margin="0,2,0,10" />

                <!-- SECTION: OCR & POPUP -->
                <TextBlock Text="OCR &amp; POPUP" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}" Margin="0,0,0,6" />

                <CheckBox x:Name="chkOcrEnabled" Content="Bật OCR — chụp màn hình và nhận dạng chữ"
                          Margin="0,0,0,6" />

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ngôn ngữ OCR" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <ComboBox x:Name="cboOcrLang" Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}" Height="28" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Phím tắt OCR" FontSize="11.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="6" Padding="10,5"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1" Height="28">
                            <TextBlock x:Name="txtOcrHotkey" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <TextBlock Text="Popup tự đóng sau (giây, 0 = tắt): " FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="txtPopupDelay" Width="50" Height="26"
                             FontSize="12" Padding="6,2" TextAlignment="Center"
                             Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                             Text="5" Margin="6,0,0,0" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Hủy" Style="{StaticResource ModernButton}" 
                    Click="CancelButton_Click" Padding="14,5" Margin="0,0,8,0" FontSize="12" Height="28" />
            <Button Content="✓ Lưu cài đặt" Style="{StaticResource AccentButton}" 
                    Click="SaveButton_Click" Padding="16,5" FontSize="12" Height="28" />
        </StackPanel>
    </Grid>
</Window>
