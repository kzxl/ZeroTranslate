<Window x:Class="XTranslate.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XTranslate Popup"
        Width="420" SizeToContent="Height"
        MaxHeight="350"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        Loaded="Window_Loaded">

    <Border CornerRadius="10" Margin="8"
            Background="#F2181A28"
            BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.45" Color="#FF0B0D14" />
        </Border.Effect>

        <Grid Margin="14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- Header -->
                <RowDefinition Height="Auto" />   <!-- Source text -->
                <RowDefinition Height="Auto" />   <!-- Divider -->
                <RowDefinition Height="*" />       <!-- Translated text -->
                <RowDefinition Height="Auto" />   <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✦" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="XTranslate" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding DetectedLanguage, StringFormat=' • {0}'}" FontSize="10.5"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ModernButton}"
                        Click="CloseButton_Click"
                        Padding="6,1" FontSize="10" Height="20"
                        ToolTip="Đóng (Esc)"
                        AutomationProperties.Name="Đóng popup" />
            </Grid>

            <!-- Source text (truncated) -->
            <TextBlock Grid.Row="1" Text="{Binding SourceText}" 
                       TextTrimming="CharacterEllipsis" MaxHeight="36"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,8" />

            <!-- Gradient divider -->
            <Border Grid.Row="2" Height="1" Margin="0,0,0,8" CornerRadius="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="{StaticResource PrimaryAccent}" Offset="0" />
                        <GradientStop Color="#40818CF8" Offset="0.5" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Translated text / Loading -->
            <Grid Grid.Row="3" MinHeight="38">
                <!-- Loading animation -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="⟳" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}"
                               Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.7" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="Đang dịch..." FontSize="12"
                               Foreground="{StaticResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Result -->
                <TextBlock Text="{Binding TranslatedText}" 
                           TextWrapping="Wrap" FontSize="13.5" LineHeight="20"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           MaxHeight="200">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTranslating}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SourceLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="88" Height="25" FontSize="10.5" />

                    <Button Content="⇄" FontSize="11" Margin="3,0"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding SwapLanguagesCommand}"
                            Padding="5,0" Height="25" ToolTip="Đảo ngôn ngữ" />

                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding TargetLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="88" Height="25" FontSize="10.5" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔊" Style="{StaticResource ModernButton}"
                            Command="{Binding SpeakCommand}"
                            Padding="7,2" FontSize="11" Height="25" Margin="0,0,4,0"
                            ToolTip="Phát âm bản dịch"
                            AutomationProperties.Name="Phát âm bản dịch"
                            Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVis}}" />
                    <Button x:Name="CopyButton" Content="📋 Copy" Style="{StaticResource ModernButton}"
                            Click="CopyButton_Click"
                            Padding="8,2" FontSize="10.5" Height="25"
                            ToolTip="Sao chép bản dịch"
                            AutomationProperties.Name="Sao chép bản dịch" />
                    <TextBlock Text="Esc đóng" FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
