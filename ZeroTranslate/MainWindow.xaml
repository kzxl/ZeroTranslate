<Window x:Class="ZeroTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroTranslate" 
        Height="460" Width="760"
        MinHeight="340" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Integrated Top Toolbar -->
            <RowDefinition Height="*" />    <!-- Translation Panels & History -->
            <RowDefinition Height="Auto" /> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- ===== INTEGRATED TOP TOOLBAR ===== -->
        <Border Grid.Row="0" Padding="12,8" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="✦" FontSize="16" Foreground="{StaticResource AccentPrimaryBrush}" 
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="ZeroTranslate" FontSize="15" FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Background="#20818CF8" CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Language Selector (Center Toolbar) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding SourceLanguages}"
                              SelectedItem="{Binding SourceLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="130" Height="28" FontSize="11.5" />

                    <Button Content="⇄" FontSize="13" FontWeight="Bold"
                            Style="{StaticResource ModernButton}"
                            Command="{Binding SwapLanguagesCommand}"
                            Padding="8,2" Height="28" Margin="6,0"
                            ToolTip="Đổi ngôn ngữ nguồn ↔ đích"
                            AutomationProperties.Name="Đổi ngôn ngữ" />

                    <ComboBox Style="{StaticResource DarkComboBox}"
                              ItemsSource="{Binding TargetLanguages}"
                              SelectedItem="{Binding TargetLanguage}"
                              DisplayMemberPath="Name"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Width="130" Height="28" FontSize="11.5" />
                </StackPanel>

                <!-- Quick Action Buttons (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="HistoryToggleButton" Content="🕒 Lịch sử" Style="{StaticResource ModernButton}"
                            Click="HistoryToggleButton_Click" Padding="9,4" FontSize="11.5" Height="28"
                            Margin="0,0,5,0"
                            ToolTip="Hiện/ẩn lịch sử dịch"
                            AutomationProperties.Name="Hiện hoặc ẩn lịch sử dịch" />
                    <Button x:Name="HudToggleButton" Content="📺 HUD" Style="{StaticResource ModernButton}"
                            Click="HudToggleButton_Click" Padding="9,4" FontSize="11.5" Height="28"
                            Margin="0,0,5,0"
                            ToolTip="Bật/Tắt HUD phụ đề nổi xuyên thấu màn hình"
                            AutomationProperties.Name="Bật tắt HUD phụ đề" />
                    <Button Content="📷 OCR" Style="{StaticResource ModernButton}"
                            Click="OcrButton_Click" Padding="9,4" FontSize="11.5" Height="28"
                            Margin="0,0,5,0"
                            ToolTip="Chụp màn hình và dịch (Ctrl+Shift+Q)"
                            AutomationProperties.Name="Chụp màn hình OCR" />
                    <Button Content="⚙ Cài đặt" Style="{StaticResource ModernButton}"
                            Click="SettingsButton_Click" Padding="9,4" FontSize="11.5" Height="28"
                            ToolTip="Cài đặt hệ thống"
                            AutomationProperties.Name="Cài đặt" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== TRANSLATION PANELS + HISTORY ===== -->
        <Grid Grid.Row="1" Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Translation panels -->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Source Panel -->
                <Border Grid.Column="0" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="12,7" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="VĂN BẢN GỐC" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}" />
                        </Border>

                        <!-- Text Input -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="12,8"
                                 FontSize="13.5" FontFamily="Segoe UI"
                                 TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 CaretBrush="{StaticResource AccentPrimaryBrush}"
                                 SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Padding="10,5" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding CharacterCount, StringFormat='{}{0} ký tự'}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="🔊" Style="{StaticResource ModernButton}"
                                            Command="{Binding SpeakSourceCommand}"
                                            Padding="7,2" FontSize="11" Height="24" Margin="0,0,4,0"
                                            ToolTip="Phát âm văn bản gốc"
                                            AutomationProperties.Name="Phát âm văn bản gốc"
                                            Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="✕ Xóa" Style="{StaticResource ModernButton}"
                                            Command="{Binding ClearCommand}"
                                            Padding="8,2" FontSize="10.5" Height="24"
                                            ToolTip="Xóa văn bản"
                                            AutomationProperties.Name="Xóa văn bản" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Target Panel -->
                <Border Grid.Column="2" Background="{StaticResource BgCardBrush}" CornerRadius="8"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="12,7" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="BẢN DỊCH" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" />
                        </Border>

                        <!-- Translation Output -->
                        <Grid Grid.Row="1">
                            <TextBox Text="{Binding TranslatedText, Mode=OneWay}"
                                     Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" Padding="12,8"
                                     FontSize="13.5" FontFamily="Segoe UI"
                                     TextWrapping="Wrap" IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SelectionBrush="{StaticResource AccentPrimaryBrush}" />

                            <!-- Empty-state placeholder -->
                            <TextBlock Text="Bản dịch sẽ hiển thị ở đây"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       FontSize="12" IsHitTestVisible="False"
                                       Margin="12,10,12,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TranslatedText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Footer Actions -->
                        <Border Grid.Row="2" Padding="10,5" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                    <Button Content="🔊" Style="{StaticResource ModernButton}"
                                            Command="{Binding SpeakResultCommand}"
                                            Padding="7,2" FontSize="11" Height="24" Margin="0,0,4,0"
                                            ToolTip="Phát âm bản dịch"
                                            AutomationProperties.Name="Phát âm bản dịch"
                                            Visibility="{Binding CanSpeak, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="📋 Copy" Style="{StaticResource ModernButton}"
                                            Command="{Binding CopyResultCommand}"
                                            Padding="8,2" FontSize="10.5" Height="24"
                                            ToolTip="Sao chép bản dịch"
                                            AutomationProperties.Name="Sao chép bản dịch" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Collapsible History Sidebar -->
            <Border x:Name="HistoryPanel" Grid.Column="1" Width="210" Margin="10,0,0,0"
                    Background="{StaticResource BgCardBrush}" CornerRadius="8"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="12,7" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <TextBlock Text="LỊCH SỬ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentPrimaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Text="🗑" FontSize="11" Cursor="Hand"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       ToolTip="Xóa toàn bộ lịch sử"
                                       MouseLeftButtonUp="ClearHistory_Click" />
                        </DockPanel>
                    </Border>

                    <ListBox Grid.Row="1" x:Name="HistoryList"
                             ItemsSource="{Binding History}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="HistoryList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="8,5">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF262A44" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#FF32385C" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}" FontSize="11.5"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TranslatedText}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    <TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,2,0,0">
                                        <Run Text="{Binding TargetLanguageCode}" />
                                        <Run Text=" • " />
                                        <Run Text="{Binding Timestamp, StringFormat='HH:mm dd/MM'}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1" Text="Chưa có lịch sử"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding History.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Row="2" Padding="10,5" FontSize="9.5"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Nhấp đúp để dùng lại" />
                </Grid>
            </Border>
        </Grid>

        <!-- ===== BOTTOM STATUS BAR ===== -->
        <Border Grid.Row="2" Padding="12,6" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Animated Spinner -->
                    <TextBlock Text="⟳" FontSize="13" Foreground="{StaticResource AccentPrimaryBrush}"
                               Visibility="{Binding IsTranslating, Converter={StaticResource BoolToVis}}"
                               Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation 
                                            Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock x:Name="txtStatus" Text="{Binding StatusText}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#15818CF8" CornerRadius="4" Padding="8,3" Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <TextBlock FontSize="9.5" Foreground="{StaticResource TextMutedBrush}">
                            <Run Text="Ctrl+Enter" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <Run Text=" dịch  ·  " />
                            <Run Text="Ctrl+Q" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <Run Text=" popup  ·  " />
                            <Run Text="Ctrl+Shift+Q" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimaryBrush}" />
                            <Run Text=" OCR" />
                        </TextBlock>
                    </Border>
                    <Button Content="▶ Dịch ngay" Style="{StaticResource AccentButton}"
                            Command="{Binding TranslateCommand}"
                            Padding="16,5" FontSize="12" Height="28" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
