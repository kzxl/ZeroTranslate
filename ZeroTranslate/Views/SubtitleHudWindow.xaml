<Window x:Class="ZeroTranslate.Views.SubtitleHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZeroTranslate Subtitle HUD"
        Width="700" Height="90" MinWidth="400" MinHeight="60"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        ShowActivated="False"
        WindowStartupLocation="Manual">

    <Border CornerRadius="12" Background="#D90C0E1A" BorderBrush="#336366F1" BorderThickness="1.2"
            Margin="10" MouseLeftButtonDown="Border_MouseLeftButtonDown" Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000" />
        </Border.Effect>

        <Grid Margin="12,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HUD Header Bar -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#336366F1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="⚡ HUD SUBTITLE" Foreground="#818CF8" FontSize="9" FontWeight="Bold" />
                    </Border>
                    <TextBlock x:Name="TxtSourceSubtitle" Text="" Foreground="#94A3B8" FontSize="11" 
                               TextTrimming="CharacterEllipsis" MaxWidth="480" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="✕" Width="20" Height="20" Background="Transparent" Foreground="#64748B"
                            BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" FontSize="11"/>
                </StackPanel>
            </Grid>

            <!-- Main Live Translated Subtitle Text -->
            <TextBlock Grid.Row="1" x:Name="TxtTranslatedSubtitle" Text="ZeroTranslate Realtime HUD Active..." 
                       Foreground="#F8FAFC" FontSize="15" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,4,0,0"/>
        </Grid>
    </Border>
</Window>
