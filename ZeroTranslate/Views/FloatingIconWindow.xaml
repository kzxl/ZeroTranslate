<Window x:Class="ZeroTranslate.Views.FloatingIconWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="32" Height="32"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        Focusable="False" ShowActivated="False"
        Deactivated="Window_Deactivated">

    <Border x:Name="IconBorder" CornerRadius="16" Cursor="Hand"
            Background="#FF6366F1"
            MouseLeftButtonDown="Icon_Click"
            MouseEnter="Icon_MouseEnter"
            MouseLeave="Icon_MouseLeave"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.45" Color="#FF0B0D14" />
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>

        <!-- Translate icon (🌐 globe) -->
        <TextBlock Text="🌐" FontSize="15" 
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Margin="0,-1,0,0" />
    </Border>
</Window>
